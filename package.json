{
  "name": "@nyugennguyen/aibridge",
  "version": "1.0.1",
  "description": "Private Tailscale bridge for OpenCode agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "aibr": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "bun dist/index.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "release:check": "bun install --frozen-lockfile && bun run build && bun test && bun run typecheck && bun dist/cli.js --help && bun pm pack --dry-run"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.17.7",
    "fastify": "5.8.5",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
