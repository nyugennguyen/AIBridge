#!/usr/bin/env bash
# Launcher for the native `aibr-tui` binary.
#
# The native binary is platform-specific and cannot live in this package's `bin/`
# directory: one tarball is downloaded by every platform, and committing a single
# build meant every Linux and x64 install received the darwin-arm64 binary
# committed to git. Executing it failed with ENOEXEC.
#
# Instead the real binaries ship as per-platform optionalDependencies (see
# `scripts/package-binaries.ts`), npm installs only the one matching the host, and
# this shim locates it. A committed binary is therefore never shipped, and the
# `bin` entry stays valid on every platform because this file is plain text.
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
bin_dir="$(cd "$(dirname "$self")" && pwd)"
pkg_root="$(dirname "$bin_dir")"

detect_libc() {
  if [ -n "${AIBRIDGE_LIBC:-}" ]; then
    case "$AIBRIDGE_LIBC" in
      glibc) printf 'gnu' ;;
      *) printf '%s' "$AIBRIDGE_LIBC" ;;
    esac
    return
  fi
  if [ -f /etc/alpine-release ] || ls /lib/ld-musl-* >/dev/null 2>&1; then
    printf 'musl'
  else
    # The published package is named `-linux-<arch>-gnu`, not `-glibc`; npm keys
    # optionalDependencies off the package name, so the directory on disk uses
    # the shorter spelling.
    printf 'gnu'
  fi
}

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) platform="darwin-arm64" ;;
  Darwin-x86_64) platform="darwin-x64" ;;
  Linux-aarch64|Linux-arm64)
    platform="linux-arm64-$(detect_libc)"
    ;;
  Linux-x86_64|Linux-amd64)
    platform="linux-x64-$(detect_libc)"
    ;;
  *)
    printf 'aibr-tui: unsupported platform %s-%s\n' "$(uname -s)" "$(uname -m)" >&2
    printf 'aibr tui will fall back to the built-in OpenTUI shell.\n' >&2
    exit 1
    ;;
esac

# Search roots, in order:
#   $pkg_root/node_modules  - a nested install
#   $pkg_root/..           - the scoped dir in a global install, where npm puts
#                            `@nyugennguyen/aibridge-<platform>` beside
#                            `@nyugennguyen/aibridge`
#   $pkg_root/../..        - the hoisted `node_modules` itself, for unscoped
#                            lookups and npm's hoisting of the platform package
for root in "$pkg_root/node_modules" "$pkg_root/.." "$pkg_root/../.." ; do
  for candidate in \
    "$root/@nyugennguyen/aibridge-$platform/bin/aibr-tui" \
    "$root/aibridge-$platform/bin/aibr-tui"; do
    if [ -x "$candidate" ]; then
      exec "$candidate" "$@"
    fi
  done
done

printf 'aibr-tui: no prebuilt binary for %s\n' "$platform" >&2
printf 'Build from source with: cargo build --release -p aibr-tui\n' >&2
exit 1