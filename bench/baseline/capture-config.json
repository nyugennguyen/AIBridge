{
  "agent_id": "dev-main",
  "bridge": {
    "host": "127.0.0.1",
    "port": 8787,
    "public_url": "http://127.0.0.1:8787"
  },
  "opencode": {
    "base_url": "http://127.0.0.1:4096",
    "server_port": 4096,
    "username": "opencode",
    "password_env": "OPENCODE_SERVER_PASSWORD"
  },
  "security": {
    "auth_mode": "bearer-token",
    "allowed_sources": [
      {
        "source_agent_id": "test-vps",
        "capabilities": [
          "testing",
          "qa"
        ],
        "requires_plan_approval": []
      }
    ]
  },
  "permissions": {
    "default_response": "reject",
    "allow_tools": [
      "read",
      "grep",
      "glob"
    ],
    "require_plan_approval_for_tools": [
      "bash",
      "edit",
      "write"
    ]
  },
  "projects": [
    {
      "id": "app-under-development",
      "path": "/Users/mac/Projects/AIBrigde",
      "capabilities": [
        "development",
        "orchestration"
      ]
    }
  ],
  "agents": [
    {
      "id": "test-vps",
      "url": "http://127.0.0.1:8788",
      "capabilities": [
        "testing",
        "qa"
      ]
    }
  ],
  "timeouts": {
    "default_job_seconds": 1800,
    "callback_retry_attempts": 3
  },
  "planning": {
    "plan_annotator_enabled": true,
    "require_approval_for": [
      "deployment",
      "destructive",
      "multi-agent-fanout"
    ]
  }
}
